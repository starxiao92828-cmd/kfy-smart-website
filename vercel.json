{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/news.html",
      "destination": "/news/",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "statusCode": 301
    },
    {
      "source": "/products.html",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/technology.html",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/solutions.html",
      "destination": "/products/",
      "statusCode": 301
    },
    {
      "source": "/partner.html",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/oem-odm.html",
      "destination": "/about/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/inquiry.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
